/// v1.3.0 直播页（底部「电视」入口）：
/// 分组频道列表 + 横屏全屏播放器（上一台/下一台/频道单/失败自动换线路）
library;

import 'dart:async';

import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import 'package:flutter/services.dart';
import 'package:video_player/video_player.dart';
import 'package:wakelock_plus/wakelock_plus.dart';

import '../iptv.dart';
import '../theme.dart';
import 'widgets.dart';

class LivePage extends StatefulWidget {
  const LivePage({super.key});

  @override
  State<LivePage> createState() => _LivePageState();
}

class _LivePageState extends State<LivePage> with AutomaticKeepAliveClientMixin {
  String? _error;
  bool _loading = true;
  String _top = '全部'; // v1.5.0 一级大类
  String _group = '全部'; // v1.5.0 二级分组
  String _kw = ''; // v1.5.1 频道名筛选关键词
  final _kwCtrl = TextEditingController();

  // ------------------------------------------------------------------
  // v2.2.4：频道量级已达 2.99 万（分组 435 种）。原实现是「每次 build 现算」：
  //   · `groupsOf()` 用 `List.contains` 线性判重 → O(n×g)，`_tops` 与 `_subGroups`
  //     各调一遍，合计约 1,300 万次字符串比较；
  //   · `_shown` 对每个频道跑一次 `topGroupOf`（内含正则 replaceAll）→ 近 3 万次正则；
  //   · 关键词归一化写在 where 内 → 每项重算一次 `normalizeName(_kw)`。
  // 频道一多，输入一个字符就会卡帧。现改为**加载后建一次索引**（IptvIndex），
  // build 只做 Map 查表。
  // ------------------------------------------------------------------
  IptvIndex _idx = IptvIndex.empty;

  @override
  bool get wantKeepAlive => true;

  @override
  void initState() {
    super.initState();
    _load();
  }

  /// 频道数据到位后重建索引（唯一入口，避免索引与数据不同步）
  void _applyChans(List<LiveChannel> chans) {
    _idx = IptvIndex.of(chans);
    // 刷新后选中的大类/分组可能已消失（上游清单每日变动）→ 回退「全部」，
    // 否则会停在一个空列表、且 chip 上没有任何选中项。
    if (_top != '全部' && !_idx.tops.contains(_top)) {
      _top = '全部';
      _group = '全部';
    }
    if (_group != '全部' && !_idx.byGroup.containsKey(_group)) _group = '全部';
  }

  Future<void> _load() async {
    setState(() {
      _loading = true;
      _error = null;
    });
    try {
      final chans = await IptvService.instance.load();
      if (!mounted) return;
      setState(() {
        _applyChans(chans);
        _loading = false;
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _error = '直播源拉取失败，请检查网络后重试';
        _loading = false;
      });
    }
  }

  /// v1.5.0：一级大类归并 —— 央视 / 卫视 / 港澳台·国际 / 地方频道
  /// v2.2.4：判定逻辑移到 [IptvService.topGroupOf]（可单测 + 与 PC 版同步的单一事实源），
  ///         并新增第 5 类「国际·其他」承接国际清单的英文分组；
  ///         页面侧不再各算一遍，统一走 [IptvIndex] 里预建好的分组→大类映射。
  List<String> get _tops => _idx.tops;

  /// 当前一级大类下实际有哪些原始分组（按出现顺序）
  List<String> get _subGroups => _idx.groupsOfTop(_top);

  List<LiveChannel> get _shown {
    // 走索引取子集，避免每次 build 全量扫描 2.99 万条
    // （二级分组名唯一，取该组即可，无需再按大类过滤一遍）
    final list = _idx.subset(_top, _group);
    if (_kw.isEmpty) return list; // 零拷贝：索引里的列表只被读取，不会被改动
    // v1.5.1 频道筛选：按台名关键词过滤（忽略大小写）
    // v2.2.4：关键词归一化提到循环外；台名侧走 LiveChannel 的懒缓存（只算一次）
    final kw = _kw.toUpperCase();
    final nkw = IptvService.normalizeName(_kw);
    return list
        .where((c) => c.nameUpper.contains(kw) || c.nameNorm.contains(nkw))
        .toList();
  }

  /// v2.2.4：搜索输入防抖 —— 2.99 万频道 + 二级 chip 最多 198 个，
  /// 逐字符 setState 会让输入发涩；停 220ms 再过滤，输入过程保持跟手。
  Timer? _kwDebounce;

  void _onKwChanged(String v) {
    _kwDebounce?.cancel();
    _kwDebounce = Timer(const Duration(milliseconds: 220), () {
      if (!mounted) return;
      final t = v.trim();
      if (t != _kw) setState(() => _kw = t);
    });
  }

  @override
  void dispose() {
    _kwDebounce?.cancel();
    _kwCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    super.build(context);
    final shown = _shown;
    return Scaffold(
      appBar: AppBar(
        title: const Text('电视'),
        actions: [
          IconButton(
            tooltip: '刷新频道',
            icon: const Icon(Icons.refresh, size: 22),
            onPressed: () async {
              await IptvService.instance.load(forceRefresh: true).then((c) {
                if (mounted) setState(() => _applyChans(c));
              }).catchError((Object e) {
                if (mounted) {
                  setState(() => _error = '刷新失败：直播源暂不可达');
                }
              });
            },
          ),
          const SizedBox(width: 4),
        ],
      ),
      body: Column(
        children: [
          if (_loading)
            const Expanded(
                child: Center(
                    child: SizedBox(
                        width: 30,
                        height: 30,
                        child: CircularProgressIndicator(strokeWidth: 2.6)))),
          if (!_loading && _error != null)
            Expanded(
              child: Center(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(Icons.live_tv_outlined,
                        size: 44, color: context.tFaint),
                    const SizedBox(height: 12),
                    Text(_error!,
                        style: TextStyle(fontSize: 13, color: context.tSub)),
                    const SizedBox(height: 14),
                    FilledButton(onPressed: _load, child: const Text('重试')),
                  ],
                ),
              ),
            ),
          if (!_loading && _error == null) ...[
            // v1.5.0 二级分类：一级大类（合并）+ 二级原始分组
            Container(
              width: double.infinity,
              color: context.card,
              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
              child: Column(children: [
                SingleChildScrollView(
                  scrollDirection: Axis.horizontal,
                  child: Row(
                    children: [
                      for (final t in ['全部', ..._tops])
                        _chip(t, _top == t,
                            onSel: () => setState(() {
                                  _top = t;
                                  _group = '全部';
                                })),
                    ],
                  ),
                ),
                // v1.5.1 频道筛选框
                Padding(
                  padding: const EdgeInsets.only(top: 6),
                  child: TextField(
                    controller: _kwCtrl,
                    onChanged: _onKwChanged,
                    textInputAction: TextInputAction.search,
                    style: const TextStyle(fontSize: 13),
                    decoration: InputDecoration(
                      isDense: true,
                      hintText: '筛选频道：输入台名关键词，如 CCTV、湖南、体育…',
                      hintStyle: TextStyle(fontSize: 12, color: context.tFaint),
                      prefixIcon: Icon(Icons.search, size: 18, color: context.tFaint),
                      suffixIcon: _kw.isEmpty
                          ? null
                          : IconButton(
                              visualDensity: VisualDensity.compact,
                              icon: Icon(Icons.cancel, size: 16, color: context.tFaint),
                              onPressed: () {
                                _kwDebounce?.cancel(); // 清空要即时生效
                                _kwCtrl.clear();
                                setState(() => _kw = '');
                              },
                            ),
                      filled: true,
                      fillColor: context.chipBg,
                      contentPadding:
                          const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(20),
                        borderSide: BorderSide.none,
                      ),
                    ),
                  ),
                ),
                if (_top != '全部' && _subGroups.length > 1)
                  Padding(
                    padding: const EdgeInsets.only(top: 4),
                    child: SingleChildScrollView(
                      scrollDirection: Axis.horizontal,
                      child: Row(
                        children: [
                          // v2.2.4：显示名走 displayGroup（英文分组翻译成中文），
                          //         筛选仍用原始分组名，两者互不影响
                          for (final g in ['全部', ..._subGroups])
                            _chip(IptvService.displayGroup(g), _group == g,
                                small: true,
                                onSel: () => setState(() => _group = g)),
                        ],
                      ),
                    ),
                  ),
              ]),
            ),
            // 频道列表
            Expanded(
              child: RefreshIndicator(
                color: context.brand,
                onRefresh: () async {
                  final c = await IptvService.instance.load(forceRefresh: true);
                  if (mounted) setState(() => _applyChans(c));
                },
                child: shown.isEmpty
                    ? const EmptyView(
                        icon: Icons.live_tv_outlined, message: '该分组暂无频道')
                    : ListView.separated(
                        physics: const AlwaysScrollableScrollPhysics(),
                        padding: const EdgeInsets.fromLTRB(12, 10, 12, 20),
                        itemCount: shown.length,
                        separatorBuilder: (_, _) => const SizedBox(height: 6),
                        itemBuilder: (_, i) {
                          final c = shown[i];
                          return Card(
                            margin: EdgeInsets.zero,
                            child: ListTile(
                              dense: true,
                              contentPadding: const EdgeInsets.symmetric(
                                  horizontal: 10, vertical: 2),
                              leading: ClipRRect(
                                borderRadius: BorderRadius.circular(6),
                                child: Container(
                                  width: 52,
                                  height: 38,
                                  color: context.chipBg,
                                  alignment: Alignment.center,
                                  child: c.logo.isNotEmpty
                                      ? NetImage(c.logo,
                                          width: 52,
                                          height: 38,
                                          fit: BoxFit.contain,
                                          borderRadius:
                                              BorderRadius.circular(6))
                                      : Icon(Icons.live_tv_rounded,
                                          size: 20, color: context.tFaint),
                                ),
                              ),
                              title: Text(c.name,
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: const TextStyle(
                                      fontSize: 13.5,
                                      fontWeight: FontWeight.w600)),
                              subtitle: Text(
                                  '${IptvService.displayGroup(c.group)} · ${c.urls.length} 条线路',
                                  style: TextStyle(
                                      fontSize: 11, color: context.tFaint)),
                              trailing: Icon(Icons.play_circle_outline,
                                  size: 22,
                                  color: context.brand.withValues(alpha: 0.7)),
                              onTap: () => _play(context, c, shown),
                            ),
                          );
                        },
                      ),
              ),
            ),
          ],
        ],
      ),
    );
  }

  /// v1.5.0：统一的分类 chip
  Widget _chip(String label, bool selected,
      {bool small = false, required VoidCallback onSel}) {
    return Padding(
      padding: const EdgeInsets.only(right: 6),
      child: ChoiceChip(
        label: Text(label,
            style: TextStyle(
                fontSize: small ? 11.5 : 12.5,
                fontWeight:
                    selected ? FontWeight.w600 : FontWeight.w400)),
        selected: selected,
        selectedColor: context.brand,
        backgroundColor: context.chipBg,
        labelStyle: TextStyle(
            color: selected ? Colors.white : context.tSub),
        side: BorderSide.none,
        showCheckmark: false,
        visualDensity: VisualDensity.compact,
        onSelected: (_) => onSel(),
      ),
    );
  }

  void _play(BuildContext context, LiveChannel c, List<LiveChannel> all) {
    Navigator.of(context).push(MaterialPageRoute(
      builder: (_) => LivePlayerPage(channel: c, all: all),
    ));
  }
}

// =============== 横屏全屏直播播放器 ===============

class LivePlayerPage extends StatefulWidget {
  final LiveChannel channel;
  final List<LiveChannel> all; // 用于频道单/上下换台
  const LivePlayerPage({super.key, required this.channel, required this.all});

  @override
  State<LivePlayerPage> createState() => _LivePlayerPageState();
}

class _LivePlayerPageState extends State<LivePlayerPage> {
  VideoPlayerController? _vp;
  int _urlIndex = 0;
  int _chanIndex = 0;
  bool _initialized = false;
  bool _buffering = true;
  String? _error;
  bool _showControls = true;
  Timer? _hideTimer;

  LiveChannel get _chan => widget.all[_chanIndex];

  @override
  void initState() {
    super.initState();
    _chanIndex = widget.all.indexWhere((c) => c.name == widget.channel.name);
    if (_chanIndex < 0) _chanIndex = 0;
    SystemChrome.setPreferredOrientations(
        [DeviceOrientation.landscapeLeft, DeviceOrientation.landscapeRight]);
    SystemChrome.setEnabledSystemUIMode(SystemUiMode.immersiveSticky);
    WakelockPlus.enable();
    _play();
  }

  Future<void> _play() async {
    setState(() {
      _initialized = false;
      _buffering = true;
      _error = null;
      _urlIndex = 0;
    });
    // v1.4.0：播放前并发探测各线路，优先选已确认存活的地址（大幅提升成功率）
    final alive = await _probeLines(_chan.urls);
    if (!mounted) return;
    if (alive >= 0) _urlIndex = alive;
    await _startCurrentUrl();
  }

  /// 并发探测线路（GET Range 请求，5s 超时），返回首个存活的下标，全失败返回 -1
  Future<int> _probeLines(List<String> urls) async {
    if (urls.isEmpty) return -1;
    final probes = urls.take(8).toList().asMap().entries.map((e) async {
      final ok = await _probeOne(e.value);
      return MapEntry(e.key, ok);
    }).toList();
    final results = await Future.wait(probes);
    for (final e in results) {
      if (e.value) return e.key;
    }
    return -1; // 探测全失败仍按原序尝试（部分服务器拒绝探测但可正常播放）
  }

  Future<bool> _probeOne(String url) async {
    try {
      final req = http.Request('GET', Uri.parse(url))
        ..headers['Range'] = 'bytes=0-2047'
        ..headers['User-Agent'] =
            'Mozilla/5.0 (Linux; Android 13) Chrome/126.0';
      final streamed = await req.send().timeout(const Duration(seconds: 5));
      final resp = await http.Response.fromStream(streamed);
      return resp.statusCode == 200 || resp.statusCode == 206;
    } catch (_) {
      return false;
    }
  }

  Future<void> _startCurrentUrl() async {
    final urls = _chan.urls;
    if (_urlIndex >= urls.length) {
      setState(() => _error = '所有线路均播放失败，可尝试换台或稍后重试');
      return;
    }
    await _vp?.dispose();
    final vp = VideoPlayerController.networkUrl(
      Uri.parse(urls[_urlIndex]),
      httpHeaders: const {
        'User-Agent': 'Mozilla/5.0 (Linux; Android 13) Chrome/126.0',
      },
    );
    _vp = vp;
    try {
      await vp.initialize().timeout(const Duration(seconds: 10));
      if (!mounted) return;
      await vp.play();
      vp.addListener(_onTick);
      setState(() {
        _initialized = true;
        _buffering = false;
      });
      _armHide();
    } catch (_) {
      if (!mounted) return;
      // 自动换下一条线路
      _urlIndex++;
      if (_urlIndex < urls.length) {
        await _startCurrentUrl();
      } else {
        setState(() {
          _error = '播放失败：所有线路均无法连接（该频道可能需要外网或已失效）';
          _buffering = false;
        });
      }
    }
  }

  void _onTick() {
    if (!mounted) return;
    final v = _vp;
    if (v == null) return;
    if (v.value.isBuffering != _buffering) setState(() => _buffering = v.value.isBuffering);
  }

  /// 直播流宽高比兜底：尺寸异常时按 16:9 显示，避免 AspectRatio 断言崩溃
  double _safeAr(VideoPlayerController vp) {
    final ar = vp.value.aspectRatio;
    if (ar <= 0 || ar.isNaN || ar.isInfinite) return 16 / 9;
    return ar;
  }

  void _armHide() {
    _hideTimer?.cancel();
    _hideTimer = Timer(const Duration(seconds: 4), () {
      if (mounted && (_vp?.value.isPlaying ?? false)) {
        setState(() => _showControls = false);
      }
    });
  }

  void _switchChan(int delta) {
    var next = _chanIndex + delta;
    if (next < 0 || next >= widget.all.length) return;
    setState(() => _chanIndex = next);
    _play();
  }

  void _selectChan(int i) {
    Navigator.pop(context);
    if (i == _chanIndex) return;
    setState(() => _chanIndex = i);
    _play();
  }

  @override
  void dispose() {
    _hideTimer?.cancel();
    _vp?.removeListener(_onTick);
    _vp?.dispose();
    SystemChrome.setEnabledSystemUIMode(SystemUiMode.edgeToEdge);
    SystemChrome.setPreferredOrientations([DeviceOrientation.portraitUp]);
    WakelockPlus.disable();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      body: GestureDetector(
        behavior: HitTestBehavior.opaque,
        onTap: () {
          setState(() => _showControls = !_showControls);
          if (_showControls) _armHide();
        },
        child: Stack(
          fit: StackFit.expand,
          children: [
            Center(
              child: _initialized && _vp != null
                  ? AspectRatio(
                      aspectRatio: _safeAr(_vp!),
                      child: VideoPlayer(_vp!))
                  : _error != null
                      ? _buildError()
                      : Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            if (_buffering)
                              const SizedBox(
                                  width: 34,
                                  height: 34,
                                  child: CircularProgressIndicator(
                                      strokeWidth: 2.6, color: Colors.white70)),
                            const SizedBox(height: 12),
                            Text('正在连接 ${_chan.name} · 线路${_urlIndex + 1}/${_chan.urls.length}…',
                                style: const TextStyle(
                                    color: Colors.white70, fontSize: 13)),
                          ],
                        ),
            ),
            if (_showControls) _buildControls(),
          ],
        ),
      ),
    );
  }

  Widget _buildError() => Padding(
        padding: const EdgeInsets.all(32),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Icon(Icons.error_outline, color: Colors.white38, size: 44),
            const SizedBox(height: 12),
            Text(_error!,
                textAlign: TextAlign.center,
                style: const TextStyle(color: Colors.white70, fontSize: 14)),
            const SizedBox(height: 16),
            Row(mainAxisSize: MainAxisSize.min, children: [
              FilledButton.tonal(
                  onPressed: () {
                    _urlIndex = 0;
                    _play();
                  },
                  child: const Text('重试')),
              const SizedBox(width: 10),
              OutlinedButton(
                  style: OutlinedButton.styleFrom(foregroundColor: Colors.white70),
                  onPressed: () => _switchChan(1),
                  child: const Text('下一台')),
            ]),
          ],
        ),
      );

  Widget _buildControls() {
    final playing = _vp?.value.isPlaying ?? false;
    return Container(
      decoration: const BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [Colors.black54, Colors.transparent, Colors.transparent, Colors.black54],
          stops: [0, 0.18, 0.72, 1],
        ),
      ),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          SafeArea(
            bottom: false,
            child: Row(children: [
              IconButton(
                icon: const Icon(Icons.arrow_back, color: Colors.white),
                onPressed: () => Navigator.of(context).pop(),
              ),
              Expanded(
                child: Text(
                    '${_chan.name} · ${IptvService.displayGroup(_chan.group)} · 线路${_urlIndex + 1}/${_chan.urls.length}',
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(color: Colors.white, fontSize: 14)),
              ),
              TextButton(
                onPressed: _showChanSheet,
                child: Text('频道(${widget.all.length})',
                    style: const TextStyle(color: Colors.white, fontSize: 13)),
              ),
            ]),
          ),
          SafeArea(
            top: false,
            child: Row(mainAxisAlignment: MainAxisAlignment.center, children: [
              TextButton(
                onPressed: () => _switchChan(-1),
                child: const Text('◀ 上一台',
                    style: TextStyle(color: Colors.white, fontSize: 14)),
              ),
              const SizedBox(width: 20),
              IconButton(
                icon: Icon(playing ? Icons.pause : Icons.play_arrow,
                    color: Colors.white, size: 34),
                onPressed: () async {
                  final vp = _vp;
                  if (vp == null) return;
                  playing ? await vp.pause() : await vp.play();
                  _armHide();
                  setState(() {});
                },
              ),
              const SizedBox(width: 20),
              TextButton(
                onPressed: () => _switchChan(1),
                child: const Text('下一台 ▶',
                    style: TextStyle(color: Colors.white, fontSize: 14)),
              ),
            ]),
          ),
        ],
      ),
    );
  }

  void _showChanSheet() {
    _hideTimer?.cancel();
    showModalBottomSheet(
      context: context,
      backgroundColor: const Color(0xFF1A1D23),
      builder: (ctx) => SafeArea(
        child: SizedBox(
          height: 420,
          child: Column(children: [
            Padding(
              padding: const EdgeInsets.all(14),
              child: Text('频道列表（${widget.all.length}）',
                  style: const TextStyle(fontWeight: FontWeight.bold)),
            ),
            Expanded(
              child: ListView.builder(
                itemCount: widget.all.length,
                itemBuilder: (_, i) {
                  final c = widget.all[i];
                  final sel = i == _chanIndex;
                  return ListTile(
                    dense: true,
                    leading: c.logo.isNotEmpty
                        ? Image.network(c.logo,
                            width: 44,
                            height: 30,
                            fit: BoxFit.contain,
                            errorBuilder: (_, _, _) =>
                                const Icon(Icons.live_tv_rounded,
                                    size: 18, color: Colors.white24))
                        : const Icon(Icons.live_tv_rounded,
                            size: 18, color: Colors.white24),
                    title: Text(c.name,
                        style: TextStyle(
                            fontSize: 13,
                            color: sel ? Colors.orangeAccent : Colors.white)),
                    subtitle: Text(IptvService.displayGroup(c.group),
                        style: const TextStyle(
                            fontSize: 10.5, color: Colors.white38)),
                    selected: sel,
                    onTap: () => _selectChan(i),
                  );
                },
              ),
            ),
          ]),
        ),
      ),
    ).then((_) => _armHide());
  }
}
